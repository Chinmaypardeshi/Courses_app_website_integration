# ==============================================================================
# DATABASE CONFIGURATION
# Production Ready: Supports Supabase Cloud, AWS RDS, Neon, or Local PostgreSQL
# ==============================================================================

# OPTION A: SUPABASE CLOUD DATABASE (Recommended for Production)
# - Direct Connection (port 5432):
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# - Transaction Pooler / Supavisor (port 6543):
#   DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# OPTION B: GRANULAR PARAMETERS (Alternative to DATABASE_URL)
# DB_HOST=db.xxxxxxxx.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_SSL=true

# Database Schema:
# - Set to 'public' for Supabase (tables show immediately in Supabase Table Editor)
# - Set to 'upsc' for isolated schema
DB_SCHEMA=public

# ==============================================================================
# SERVER & SECURITY
# ==============================================================================
PORT=3000
JWT_SECRET=your_production_jwt_secret_change_me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# ==============================================================================
# THIRD-PARTY INTEGRATIONS
# ==============================================================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

GROQ_API_KEY=your_groq_api_key

# Razorpay Payment Gateway (Get from https://dashboard.razorpay.com -> Settings -> API Keys)
# Kept blank by default so client can add their own Razorpay account credentials:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
